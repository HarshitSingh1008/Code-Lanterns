{
  "expo": {
    "name": "Family Nexus AI",
    "slug": "family-nexus-ai",
    "description": "A private, local-first family assistant that knows the household without ever sending it anywhere.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "familynexus",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#6C7CE4",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ai.familynexus.app",
      "supportsTablet": true
    },
    "android": {
      "package": "ai.familynexus.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F3FB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "Family Nexus AI",
      "shortName": "Nexus",
      "lang": "en",
      "themeColor": "#6C7CE4",
      "backgroundColor": "#F4F3FB",
      "description": "A private, local-first family assistant that knows the household without ever sending it anywhere.",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F3FB",
          "dark": {
            "backgroundColor": "#12131F"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
